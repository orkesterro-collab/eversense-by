{
  "version": 8,
  "name": "EVERSENSE · Беларусь",
  "metadata": {"eversense:woodland": "Generalized OpenFreeMap landcover (wood), 2026-11-22, z7, x70–77/y38–44. © OpenStreetMap contributors, ODbL."},
  "sources": {
    "overview-woodland": {"type": "image", "url": "assets/partners-woodland.png?v=20261126-map", "coordinates": [[16.875, 58.8137417], [39.375, 58.8137417], [39.375, 47.0401821], [16.875, 47.0401821]]},
    "openfreemap": {"type": "vector", "url": "https://tiles.openfreemap.org/planet"},
    "dealer-cities": {"type": "geojson", "data": {"type": "FeatureCollection", "features": []}}
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "land", "type": "background",
      "paint": {"background-color": "#e1e1e1"}
    },
    {
      "id": "overview-woodland", "type": "raster", "source": "overview-woodland", "maxzoom": 7.3,
      "paint": {"raster-opacity": ["interpolate", ["linear"], ["zoom"], 3, 0.6, 4.5, 1, 6.9, 1, 7.3, 0], "raster-fade-duration": 0}
    },
    {
      "id": "vegetation", "type": "fill", "source": "openfreemap", "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["wood", "grass", "farmland", "wetland"]]],
      "paint": {"fill-color": ["match", ["get", "class"], "wood", "#d7d7d7", "wetland", "#d4d4d4", "grass", "#dedede", "#e3e3e3"], "fill-antialias": false}
    },
    {
      "id": "settlement", "type": "fill", "source": "openfreemap", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "suburb", "industrial", "commercial"]]],
      "paint": {"fill-color": ["match", ["get", "class"], "industrial", "#dedcda", "#eae7e2"], "fill-opacity": 0.8}
    },
    {
      "id": "parks", "type": "fill", "source": "openfreemap", "source-layer": "park", "minzoom": 8,
      "paint": {"fill-color": "#d7d7d7", "fill-opacity": 0.6}
    },
    {
      "id": "water", "type": "fill", "source": "openfreemap", "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"], "paint": {"fill-color": "#bcbcbc"}
    },
    {
      "id": "rivers", "type": "line", "source": "openfreemap", "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {"line-color": "#aaa", "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 4, 0.45, 8, 0.85, 14, 2.5, 18, 6]}
    },
    {
      "id": "buildings", "type": "fill", "source": "openfreemap", "source-layer": "building", "minzoom": 13,
      "paint": {"fill-color": "#d8d4cd", "fill-outline-color": "#c8c4bd"}
    },
    {
      "id": "paths", "type": "line", "source": "openfreemap", "source-layer": "transportation", "minzoom": 13,
      "filter": ["in", ["get", "class"], ["literal", ["path", "track"]]],
      "paint": {"line-color": "#c6c0ac", "line-dasharray": [2, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.8, 18, 2]}
    },
    {
      "id": "rail", "type": "line", "source": "openfreemap", "source-layer": "transportation", "minzoom": 9,
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {"line-color": "#b8b3ab", "line-dasharray": [4, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.55, 17, 2]}
    },
    {
      "id": "street-edges", "type": "line", "source": "openfreemap", "source-layer": "transportation", "minzoom": 10,
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "tertiary"]]],
      "layout": {"line-join": "round", "line-cap": "round"},
      "paint": {"line-color": "#d6d1c7", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 10, 0.6, 14, 3.5, 18, 14]}
    },
    {
      "id": "streets", "type": "line", "source": "openfreemap", "source-layer": "transportation", "minzoom": 11,
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "tertiary"]]],
      "layout": {"line-join": "round", "line-cap": "round"},
      "paint": {"line-color": "#ffffff", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 11, 0.5, 14, 2.3, 18, 12]}
    },
    {
      "id": "main-road-edges", "type": "line", "source": "openfreemap", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]],
      "layout": {"line-join": "round", "line-cap": "round"},
      "paint": {"line-color": "#928e88", "line-width": ["interpolate", ["exponential", 1.35], ["zoom"], 4, 0.55, 7, 1.1, 12, 3.2, 18, 19]}
    },
    {
      "id": "main-roads", "type": "line", "source": "openfreemap", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]],
      "layout": {"line-join": "round", "line-cap": "round"},
      "paint": {"line-color": ["interpolate", ["linear"], ["zoom"], 5, "#8f8d88", 8, "#a8a39a", 12, "#fff2bd"], "line-width": ["interpolate", ["exponential", 1.35], ["zoom"], 4, 0.15, 7, 0.65, 12, 2, 18, 16]}
    },
    {
      "id": "regions", "type": "line", "source": "openfreemap", "source-layer": "boundary", "minzoom": 5,
      "filter": ["all", ["==", ["get", "admin_level"], 4], ["!=", ["get", "maritime"], 1]],
      "paint": {"line-color": "#bab5af", "line-dasharray": [3, 3], "line-width": 0.85}
    },
    {
      "id": "borders", "type": "line", "source": "openfreemap", "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], 1], ["!=", ["get", "disputed"], 1], ["!", ["has", "claimed_by"]]],
      "layout": {"line-join": "round"},
      "paint": {"line-color": "#aaa6a1", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.7, 7, 1, 12, 2.4]}
    },
    {
      "id": "disputed-borders", "type": "line", "source": "openfreemap", "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["==", ["get", "disputed"], 1], ["!=", ["get", "maritime"], 1]],
      "paint": {"line-color": "#aaa6a1", "line-dasharray": [3, 2], "line-width": 1}
    },
    {
      "id": "house-numbers", "type": "symbol", "source": "openfreemap", "source-layer": "housenumber", "minzoom": 16.5,
      "layout": {"text-field": ["to-string", ["get", "housenumber"]], "text-font": ["Noto Sans Regular"], "text-size": 10},
      "paint": {"text-color": "#716e68", "text-halo-color": "#f5f3ee", "text-halo-width": 1}
    },
    {
      "id": "road-names", "type": "symbol", "source": "openfreemap", "source-layer": "transportation_name", "minzoom": 11,
      "layout": {"symbol-placement": "line", "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 17, 13], "text-max-angle": 30},
      "paint": {"text-color": "#706c63", "text-halo-color": "#fff", "text-halo-width": 1.25}
    },
    {
      "id": "road-numbers", "type": "symbol", "source": "openfreemap", "source-layer": "transportation_name", "minzoom": 6, "maxzoom": 12,
      "filter": ["all", ["has", "ref"], ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]]],
      "layout": {"symbol-placement": "line", "symbol-spacing": 280, "text-field": ["get", "ref"], "text-font": ["Noto Sans Bold"], "text-size": 9, "text-rotation-alignment": "viewport"},
      "paint": {"text-color": "#65625c", "text-halo-color": "#fffefa", "text-halo-width": 1.5}
    },
    {
      "id": "water-names", "type": "symbol", "source": "openfreemap", "source-layer": "water_name", "minzoom": 8,
      "layout": {"text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11},
      "paint": {"text-color": "#607a91", "text-halo-color": "#deebf2", "text-halo-width": 1}
    },
    {
      "id": "localities", "type": "symbol", "source": "openfreemap", "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "village", "suburb", "neighbourhood", "hamlet"]]],
      "layout": {
        "text-field": ["step", ["zoom"], ["case", ["==", ["get", "class"], "city"], ["coalesce", ["get", "name:ru"], ["get", "name"]], ""], 6, ["case", ["in", ["get", "class"], ["literal", ["city", "town"]]], ["coalesce", ["get", "name:ru"], ["get", "name"]], ""], 10, ["coalesce", ["get", "name:ru"], ["get", "name"]]],
        "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 8, 13, 14, 15],
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99], "text-anchor": "left", "text-offset": [1.15, 0], "text-padding": 3
      },
      "paint": {"text-color": "#343330", "text-halo-color": "#fff", "text-halo-width": 1.4}
    },
    {
      "id": "countries", "type": "symbol", "source": "openfreemap", "source-layer": "place", "maxzoom": 7,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {"text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 3, 9, 6, 11], "text-transform": "uppercase", "text-letter-spacing": 0.13, "text-padding": 4},
      "paint": {"text-color": "#77716e", "text-halo-color": "#fff", "text-halo-width": 1.5}
    },
    {
      "id": "dealer-city-names", "type": "symbol", "source": "dealer-cities", "maxzoom": 9,
      "layout": {
        "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
        "text-variable-anchor": ["left", "right", "bottom", "top"], "text-radial-offset": 1.5,
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 7, 13],
        "text-justify": "auto", "text-padding": 2, "symbol-sort-key": ["get", "priority"]
      },
      "paint": {"text-color": "#373530", "text-halo-color": "#fffefa", "text-halo-width": 1.5}
    }
  ]
}
