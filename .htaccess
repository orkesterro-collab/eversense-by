# Apache fallback for the hoster.by document root. The hosting platform may
# serve static files directly through nginx; verify response headers after
# publication before relying on these rules. No rewrite or routing changes.

# Compress text, leaving already-compressed images, video and fonts alone.
# mod_deflate adds the required Vary: Accept-Encoding header itself.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
    </IfModule>
</IfModule>

<IfModule mod_headers.c>
    # Revalidate documents so edits and promotion dates are visible immediately.
    <FilesMatch "(?i)\.html?$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Some scripts and data retain stable filenames. Never mark them immutable.
    <FilesMatch "(?i)\.(css|js|json|txt|xml)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>

    # Reuse media on return visits, with a bounded cache for mutable filenames.
    <FilesMatch "(?i)\.(avif|webp|png|jpe?g|gif|svg|ico|woff2?|ttf|otf|mp4|webm|pdf)$">
        Header set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>
</IfModule>
